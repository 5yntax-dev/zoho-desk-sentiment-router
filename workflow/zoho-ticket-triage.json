    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const s = $('Code in JavaScript').first().json;\nconst tone = $('Merge').first().json.sentimentAnalysis?.category || 'Neutral';\nconst raw = $json.text || $json.output || '';\nconst r = JSON.parse(raw.replace(/```json|```/g, '').trim());\nconst order = ['Low', 'Medium', 'High', 'Urgent'];\nlet priority = r.priority;\nif (tone === 'Negative') priority = order[Math.min(order.indexOf(priority) + 1, 3)];\nconst tags = [...new Set([...(r.tags || []), r.category, `tone-${tone}`].filter(Boolean))]\n  .map((t) => String(t).toLowerCase().replace(/\\s+/g, '-'));\nreturn { json: {\n  ticketId: s.ticketId, tone, priority, tags,\n  note: `Customer tone: ${tone}\\nCategory: ${r.category}\\nPriority: ${priority}`\n} };"
      },
