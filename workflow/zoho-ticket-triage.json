    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const trig = $('Zoho Desk Trigger').item.json;\nconst src = trig.payload || trig.body?.payload || trig;\nconst thread = $json;\n\nconst names = new Set();\nconst walk = (o, k = '') => {\n  if (o && typeof o === 'object') {\n    for (const [key, v] of Object.entries(o)) walk(v, key);\n  } else if (typeof o === 'string' && /^(first|last|full|display|contact|customer)?_?name$/i.test(k)) {\n    o.split(/\\s+/).forEach((p) => p.length > 1 && names.add(p));\n    if (o.length > 1) names.add(o);\n  }\n};\nwalk(trig);\n\nconst esc = (s) => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst sorted = [...names].sort((a, b) => b.length - a.length);\n\nconst mask = (s) => {\n  if (!s) return s;\n  let out = String(s)\n    .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[EMAIL]');\n  for (const n of sorted) {\n    out = out.replace(new RegExp(esc(n), 'gi'), '[NAME]');\n  }\n  return out\n    .replace(/https?:\\/\\/\\S+/g, '[URL]')\n    .replace(/\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b/g, '[IP]')\n    .replace(/\\b\\d{3}-\\d{2}-\\d{4}\\b/g, '[SSN]')\n    .replace(/\\b(?:\\d[ -]?){13,16}\\b/g, '[CARD]')\n    .replace(/\\+?\\d[\\d\\s().-]{7,}\\d/g, '[PHONE]')\n    .replace(/\\b\\d{1,2}[\\/.-]\\d{1,2}[\\/.-]\\d{2,4}\\b/g, '[DATE]')\n    .replace(/\\b\\d{5,}\\b/g, '[NUMBER]')\n    .replace(/\\b\\d{1,5}\\s+[A-Za-z0-9.\\s]{2,30}\\s(?:Street|St|Road|Rd|Avenue|Ave|Lane|Ln|Drive|Dr|Blvd)\\b/gi, '[ADDRESS]');\n};\n\nreturn {\n  json: {\n    ticketId: src.id,\n    subject: mask(src.subject),\n   description: mask(thread.content || thread.summary || src.description || src.contact?.description)\n  }\n};"
      },
